{
  "expo": {
    "name": "كرنش تايم",
    "slug": "crunch-time",
    "scheme": "crunchtime",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9a6d00c8-b273-40a6-9ca6-657943ac302c"
    },
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crunchtime.owner"
    },
    "android": {
      "package": "com.crunchtime.owner",
      "adaptiveIcon": {
        "backgroundColor": "#05070B",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "./plugins/withCleartextTraffic",
      [
        "expo-camera",
        {
          "cameraPermission": "التطبيق محتاج الكاميرا عشان تمسح كود ربط الخادم."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F7",
          "dark": {
            "backgroundColor": "#05070B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a6d00c8-b273-40a6-9ca6-657943ac302c"
      }
    },
    "owner": "shinbingos-team"
  }
}
