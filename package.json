{
  "name": "fastfood-cashier",
  "version": "1.2.1",
  "description": "Fast Food Cashier App",
  "author": {
    "name": "Fast Food",
    "email": "support@fastfood.local"
  },
  "homepage": "https://github.com/Ahmedabuseta/crunch-time",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmedabuseta/crunch-time.git"
  },
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "node scripts/build-electron.mjs",
    "build:electron:watch": "node scripts/build-electron.mjs --watch",
    "icons": "node scripts/generate-icon.mjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"node scripts/build-electron.mjs --watch\" \"npx wait-on http://localhost:5173 dist-electron/main.cjs && NODE_ENV=development electron .\"",
    "electron:start": "NODE_ENV=production electron .",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.511.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "argon2@0.45.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.fastfood.cashier",
    "productName": "Crunch Time",
    "artifactName": "Crunch-Time-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron.cjs",
      "build/icon.png",
      "package.json"
    ],
    "icon": "build/icon",
    "publish": {
      "provider": "github",
      "owner": "Ahmedabuseta",
      "repo": "crunch-time"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "نظام نقاط بيع للمطاعم",
      "description": "نظام كاشير وإيصالات حرارية للمطاعم والمقاهي",
      "maintainer": "Fast Food <support@fastfood.local>",
      "vendor": "Fast Food",
      "mimeTypes": [
        "application/x-fastfood-receipt"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Crunch Time"
    }
  }
}
